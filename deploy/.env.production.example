# Poliscope — Production Environment Variables
# Copy this file to deploy/.env.production and fill in real values.
# deploy/.env.production is gitignored — never commit it.

# PostgreSQL connection string — used by Nuxt runtimeConfig.databaseUrl
# Key: NUXT_DATABASE_URL (must match runtimeConfig key in nuxt.config.ts)
NUXT_DATABASE_URL=postgresql://poliscope:PASSWORD@localhost:5432/poliscope

# Public site URL (used by @nuxtjs/sitemap)
NUXT_SITE_URL=https://poliscope.fr
